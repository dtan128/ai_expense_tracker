# --- Telegram ---
# Get this from @BotFather after creating your bot with /newbot
TELEGRAM_BOT_TOKEN=

# A random string you choose yourself (e.g. `openssl rand -hex 32`).
# Telegram echoes this back in a header on every webhook call so we can verify
# the request really came from Telegram and not a random POST to your URL.
TELEGRAM_WEBHOOK_SECRET=

# Your own numeric Telegram user id (message @userinfobot to get it).
# The bot will refuse to log expenses from anyone else — this is a single-user app.
TELEGRAM_ALLOWED_USER_ID=

# --- Supabase ---
# Project Settings -> API in your Supabase dashboard
SUPABASE_URL=
# Use the SERVICE ROLE key (not the anon key) since this runs server-side only
# and needs to bypass row-level security to write on the user's behalf.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# The public URL Vercel gives your deployment, e.g. https://your-app.vercel.app
# Used only by the set-webhook script to tell Telegram where to send updates.
PUBLIC_APP_URL=
